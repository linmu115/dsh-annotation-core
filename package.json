{
  "name": "dsh-annotation-core",
  "version": "0.3.12-dsh021rc3.1",
  "private": false,
  "description": "Shared annotation state, submission, prompt, and UI core for DeepSeek Harness plugins.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol/index.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client-api": {
      "types": "./lib/types/public/client-api.d.ts",
      "default": "./lib/client-api.js"
    },
    "./host-api": {
      "types": "./lib/types/public/host-api.d.ts",
      "default": "./lib/host-api.js"
    },
    "./typert": {
      "types": "./lib/types/remote/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/types/remote/client.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/changes",
    "docs/release/verification.md",
    "docs/native-selection-actions.md",
    "CHANGELOG.md",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "scripts/patch-native-reference-input.mjs",
    "docs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "dshKnowledge": {
    "annotationProtocolVersion": 2
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:profile-data",
      "prompt:modify",
      "session:read",
      "session:write",
      "ui:modify"
    ],
    "capability": {
      "id": "annotation-core",
      "kind": "service",
      "invocation": "mount the web profile and register an annotation source",
      "expected": "annotationCoreHost and annotationCore services are available to consumer plugins"
    },
    "evidence": {
      "install": "docs/release/verification.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown --config-loader unrun --config tsdown.config.ts",
    "prepare": "pnpm build",
    "pretest": "pnpm build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "vitest": "vitest --pool=threads --maxWorkers=1",
    "check": "pnpm typecheck && pnpm test && pnpm pack --dry-run --json",
    "build:official": "node scripts/build-official.mjs",
    "test:host": "vitest run --config vitest.host.config.ts --pool=threads --maxWorkers=1",
    "package:release": "node scripts/package-release.mjs",
    "prepare:host": "node scripts/prepare-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "*",
    "react": "*",
    "react-dom": "*",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:.dsh-host/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:.dsh-host/packages/core/agent",
    "@deepseek-ai/dsh-agent-loop": "link:.dsh-host/packages/core/agent-loop",
    "@deepseek-ai/dsh-api-gateway": "link:.dsh-host/packages/api/gateway",
    "@deepseek-ai/dsh-api-remotes": "link:.dsh-host/packages/api/remotes",
    "@deepseek-ai/dsh-api-session-controller": "link:.dsh-host/packages/api/session-controller",
    "@deepseek-ai/dsh-attachment": "link:.dsh-host/packages/attachment/attachment",
    "@deepseek-ai/dsh-attachment-local": "link:.dsh-host/packages/attachment/attachment-local",
    "@deepseek-ai/dsh-client-file-upload": "link:.dsh-host/packages/client/file-upload",
    "@deepseek-ai/dsh-client-ui-conversation": "link:.dsh-host/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-input-trigger": "link:.dsh-host/packages/client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-slots": "link:.dsh-host/packages/client/ui-slots",
    "@deepseek-ai/dsh-llm": "link:.dsh-host/packages/llm/llm",
    "@deepseek-ai/dsh-scope": "link:.dsh-host/packages/core/scope",
    "@deepseek-ai/dsh-session": "link:.dsh-host/packages/core/session",
    "@deepseek-ai/dsh-session-projection": "link:.dsh-host/packages/session/session-projection",
    "@deepseek-ai/dsh-storage": "link:.dsh-host/packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:.dsh-host/packages/storage/storage-domain",
    "@deepseek-ai/dsh-storage-json": "link:.dsh-host/packages/storage/storage-json",
    "@deepseek-ai/dsh-system-prompt": "link:.dsh-host/packages/core/system-prompt",
    "@deepseek-ai/dsh-timeout": "link:.dsh-host/packages/util/timeout",
    "@deepseek-ai/dsh-token-meter": "link:.dsh-host/packages/llm/token-meter",
    "@deepseek-ai/dsh-tools": "link:.dsh-host/packages/core/tools",
    "@deepseek-ai/dsh-typert-loader": "link:.dsh-host/packages/typert/loader",
    "@deepseek-ai/dsh-typert-protocol": "link:.dsh-host/packages/typert/protocol",
    "@deepseek-ai/dsh-typert-registry": "link:.dsh-host/packages/typert/registry",
    "@deepseek-ai/schemastery": "link:.dsh-host/vendor/schemastery",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "jsdom": "26.1.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8",
    "tar": "7.5.22",
    "@deepseek-ai/dsh-client-connection": "link:.dsh-host/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-workspace": "link:.dsh-host/packages/client/ui-workspace"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-file-upload": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-annotation-core.git"
  },
  "bugs": "https://github.com/linmu115/dsh-annotation-core/issues",
  "homepage": "https://github.com/linmu115/dsh-annotation-core#readme"
}
