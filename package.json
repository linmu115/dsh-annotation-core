{
  "name": "dsh-annotation-core",
  "version": "0.2.0",
  "private": false,
  "description": "Shared annotation state, submission, prompt, and UI core for DeepSeek Harness plugins.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol/index.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client-api": {
      "types": "./lib/types/public/client-api.d.ts",
      "default": "./lib/client-api.js"
    },
    "./host-api": {
      "types": "./lib/types/public/host-api.d.ts",
      "default": "./lib/host-api.js"
    },
    "./typert": {
      "types": "./lib/types/remote/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/types/remote/client.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "lib/client-api.js",
    "lib/host-api.js",
    "lib/typert.js",
    "lib/remote.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "dshKnowledge": {
    "annotationProtocolVersion": 2
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:profile-data",
      "prompt:modify",
      "session:read",
      "session:write",
      "ui:modify"
    ],
    "capability": {
      "id": "annotation-core",
      "kind": "service",
      "invocation": "mount the web profile and register an annotation source",
      "expected": "annotationCoreHost and annotationCore services are available to consumer plugins"
    },
    "evidence": {
      "install": "docs/release/verification.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown --config-loader unrun --config tsdown.config.ts",
    "prepare": "pnpm build",
    "pretest": "pnpm build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "vitest": "vitest --pool=threads --maxWorkers=1",
    "check": "pnpm typecheck && pnpm test && pnpm pack --dry-run --json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-input-trigger": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment-local": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-loader": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.1-rc.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "jsdom": "26.1.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-annotation-core.git"
  },
  "bugs": "https://github.com/linmu115/dsh-annotation-core/issues",
  "homepage": "https://github.com/linmu115/dsh-annotation-core#readme"
}
